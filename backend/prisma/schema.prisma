generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum MoodLabel {
  Happy
  Anxious
  Stressed
  Sad
  Calm
  Bored
}

enum WorkloadLevel {
  Low
  Medium
  High
}

enum MealType {
  Breakfast
  Lunch
  Dinner
  Snack
  Other
}

enum FoodCategory {
  Healthy
  Neutral
  Sugary
  Junk
  Skipped
}

enum PortionRating {
  Small
  Normal
  Large
  Binge
}

enum TimeOfDay {
  Morning
  Afternoon
  Evening
  Night
}

model User {
  id              String           @id @default(uuid()) @db.Uuid
  email           String           @unique @db.VarChar(320)
  displayName     String           @map("display_name") @db.VarChar(100)
  passwordHash    String?          @map("password_hash") @db.VarChar(255)
  googleSub       String?          @unique @map("google_sub") @db.VarChar(255)
  role            String           @default("USER") @db.VarChar(32)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  refreshSessions RefreshSession[]
  moodLogs        MoodLog[]
  eatingLogs      EatingLog[]

  @@map("users")
}

model RefreshSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("refresh_sessions")
}

model MoodLog {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  moodScore   Int           @map("mood_score")
  moodLabel   MoodLabel     @map("mood_label")
  stressLevel Int           @map("stress_level")
  energyLevel Int           @map("energy_level")
  sleepHours  Float         @map("sleep_hours")
  workload    WorkloadLevel
  notes       String?
  loggedAt    DateTime      @default(now()) @map("logged_at") @db.Timestamptz(3)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
  @@map("mood_logs")
}

model EatingLog {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  mealType      MealType       @map("meal_type")
  foodCategory  FoodCategory   @map("food_category")
  portionRating PortionRating  @map("portion_rating")
  hungerBefore  Int            @map("hunger_before")
  timeOfDay     TimeOfDay      @map("time_of_day")
  description   String?
  loggedAt      DateTime       @default(now()) @map("logged_at") @db.Timestamptz(3)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
  @@map("eating_logs")
}
